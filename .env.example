# Copie este arquivo para ".env" e preencha os valores:
#   Windows (PowerShell):  copy .env.example .env
#   Linux/Mac/Git Bash:    cp .env.example .env
# O arquivo .env NÃO vai para o git (está no .gitignore). O .env.example VAI.

# Chave do serviço de Reconhecimento no CompreFace
# (CompreFace em http://localhost:8000 -> Applications -> seu app -> seu serviço -> API key)
COMPREFACE_API_KEY=cole-aqui-a-chave-do-seu-servico

# Banco de dados do JBVision (PostgreSQL)
DB_NAME=JBVision
DB_USERNAME=postgres
DB_PASSWORD=troque-esta-senha

# Opcionais (já têm valor padrão, só descomente se precisar mudar):
# DB_PORT=5432
# COMPREFACE_URL=http://localhost:8000/api/v1/recognition/recognize
